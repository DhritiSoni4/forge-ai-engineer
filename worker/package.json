{
  "name": "forge-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "run:agent": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-cli.ts",
    "sandbox": "tsx src/sandbox-cli.ts",
    "sandbox:build": "tsx src/sandbox-cli.ts build",
    "sandbox:reap": "tsx src/sandbox-cli.ts reap",
    "eval": "tsx src/eval-cli.ts",
    "eval:validate": "tsx src/eval-cli.ts validate",
    "engineer": "tsx src/engineer-cli.ts",
    "serve": "tsx src/server-cli.ts",
    "record:demo": "tsx scripts/record-traces.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/server-filesystem": "^2.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
