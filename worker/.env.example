# Copy to .env (git-ignored) or export in your shell. Never commit real values.
ANTHROPIC_API_KEY=
# Directory the filesystem MCP server may access. Use a dedicated scratch dir.
FORGE_WORKSPACE=
# GitHub fine-grained PAT with read-only scopes for the repos you want to expose.
GITHUB_TOKEN=
# Optional: path to an alternative MCP config.
# FORGE_MCP_CONFIG=
